.container {
  padding: 50rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 0rpx;
  text-align: center;
}

.title {
  font-size: 50rpx;
  font-weight: 600;
  color: #2c3e50;
}

.input-area {
  width: 80%; 
  background-color: #ffffff;
  border-radius: 25rpx;
  padding: 50rpx;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 40rpx;
  margin: 10rpx auto;
}

.input-area textarea {
  width: 100%;
  font-size: 32rpx;
  line-height: 1.5;
  min-height: 200rpx;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 80rpx;
  margin-bottom: 20rpx;
}

.lang-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker {
  background-color: #f0f2f5;
  padding: 20rpx 30rpx;
  border-radius: 60rpx;
  font-size: 28rpx;
  color: #2c3e50;
  display: flex;
  align-items: center;
}

.icon {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.swap-btn {
  background-color: #3498db;
  color: white;
  border-radius: 50%;
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  padding: 0;
  margin: 0 20rpx;
}

button[type="primary"] {
  background-color: #3498db;
  border-radius: 60rpx;
  font-size: 32rpx;
  margin-bottom: 80rpx;
}

button[disabled] {
  background-color: #b0c4de !important;
  opacity: 0.6;
}

.result-area {
  width: 80%;
  margin: 10rpx auto;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 60rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #2c3e50;
}

.copy-btn {
  background-color: transparent;
  border: 2rpx solid #3498db;
  color: #3498db;
  font-size: 22rpx !important;
  padding: 4rpx 20rpx !important;
  border-radius: 40rpx;
  align-self: center;
   
  
}

.result-content {
  font-size: 32rpx;
  line-height: 1.6;
  color: #34495e;
  word-break: break-word;
}